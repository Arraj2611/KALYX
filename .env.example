# Application
APP_NAME=KALYX Trading System
APP_VERSION=1.0.0
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Database
DATABASE_URL=postgresql://kalyx:kalyx@localhost:5432/kalyx
DATABASE_ECHO=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Zerodha API
ZERODHA_API_KEY=your_api_key_here
ZERODHA_API_SECRET=your_api_secret_here
ZERODHA_REQUEST_TOKEN=

# Security
SECRET_KEY=change-me-in-production-use-strong-random-key
ENCRYPTION_KEY=

# Risk Management
MAX_CAPITAL_USAGE_PCT=80.0
MAX_LOSS_PER_DAY=50000.0
MAX_TRADES_PER_DAY=50

# LLM Configuration
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=gpt-4

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Trading
DEFAULT_INSTRUMENT_TYPE=OPTIDX
DEFAULT_EXCHANGE=NFO


# Required: every trading and control endpoint answers 401/503 without it (send as the X-API-Key header)
CONTROL_API_KEY=
# Local development only: run the API with no key. Anyone who can reach the server can place orders.
API_AUTH_DISABLED=false
# Frontend: same value as CONTROL_API_KEY (visible in the browser bundle; use only for a dashboard you run yourself)
# NEXT_PUBLIC_CONTROL_API_KEY=
